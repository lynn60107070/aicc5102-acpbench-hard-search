# Copy to .env (never commit .env). Any OpenAI-compatible endpoint works.
# Everyone must use the SAME model and endpoint for results that go in the paper.

# Default: OpenRouter (Llama 3.1 8B Instruct, ~$0.05 / 1M input tokens). Key: https://openrouter.ai/keys
OPENAI_API_KEY=your-key-here
ACP_MODEL=meta-llama/llama-3.1-8b-instruct
ACP_BASE_URL=https://openrouter.ai/api/v1
# Pin one backend so every request runs at the same precision. CoreWeave serves bf16 (full precision);
# DeepInfra, Novita and Cloudflare serve fp8, Groq doesn't say. Check:
# https://openrouter.ai/api/v1/models/meta-llama/llama-3.1-8b-instruct/endpoints
ACP_PROVIDER=CoreWeave

# Alternatives:
# Hugging Face Inference Providers (HF token as key):
#   ACP_MODEL=meta-llama/Llama-3.1-8B-Instruct   ACP_BASE_URL=https://router.huggingface.co/v1
# Ollama (needs a GPU to be practical):
#   ACP_MODEL=llama3.1:8b                         ACP_BASE_URL=http://localhost:11434/v1
# Groq retired llama-3.1-8b-instant on 16 Aug 2026; still usable for quick pipeline tests:
#   ACP_MODEL=openai/gpt-oss-20b                  ACP_BASE_URL=https://api.groq.com/openai/v1
